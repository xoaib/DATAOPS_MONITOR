# Environment variable example
# Copy this file to .env and fill in your values.
# The application currently uses SQLite, so no DB credentials are needed.

# Application settings
APP_ENV=development
APP_PORT=8000

# Database (SQLite is used by default — no credentials required)
# DB_PATH=dataops.db

# If you switch to PostgreSQL in the future:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dataops
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password   <-- Never commit real passwords
